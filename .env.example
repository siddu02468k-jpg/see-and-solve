# ==========================================
# SEE & SOLVE PRO - ENVIRONMENT CONFIGURATION
# ==========================================

# Port for See & Solve Web Server
PORT=5050

# Multimodal AI Vision API Key (Google AI Studio)
# When configured, calls live Gemini 1.5/2.0 Flash multimodal vision API.
# When empty, seamlessly operates with built-in domain reasoning engine.
GEMINI_API_KEY=

# YouTube Data API v3 Key (Google Cloud Console)
# Used for live YouTube tutorial video retrieval and embed verification.
# When empty, honestly notifies user and provides targeted external YouTube search.
YOUTUBE_API_KEY=

# Google Places API Key
# Used for live local technician and service provider discovery.
# When empty, utilizes verified Andhra Pradesh directory and direct Google Maps query.
GOOGLE_PLACES_API_KEY=

# Secret key for signing sessions
SESSION_SECRET=see-and-solve-secure-key-2026

# Environment
NODE_ENV=development
